{
  "name": "pykorail-site",
  "private": true,
  "type": "module",
  "description": "pykorail 랜딩 페이지와 문서 사이트. 페이지는 저장소의 Markdown 에서 빌드 시점에 만들어집니다.",
  "scripts": {
    "sync": "node scripts/sync-docs.mjs",
    "dev": "npm run sync && astro dev",
    "build": "npm run sync && astro build --force && node scripts/check-links.mjs",
    "preview": "astro preview",
    "check": "npm run sync && astro check"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.7",
    "@fontsource/ibm-plex-sans-kr": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "astro": "7.4.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "postcss-selector-parser": "7.1.6"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
